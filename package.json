{
  "name": "nexo-assist",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Nexo Assist - agent de service desk de TI",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build && npm run start",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('public','dist/public',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/policy.test.mjs tests/postgres.integration.test.mjs tests/postgres-http.integration.test.mjs tests/annex-a.acceptance.test.mjs tests/initialization.test.mjs tests/mastra-provider.test.mjs tests/audit-redaction.test.mjs",
    "seed": "node --disable-warning=ExperimentalWarning dist/seed.js",
    "start:env": "node --env-file=.env --disable-warning=ExperimentalWarning dist/server.js",
    "smoke:mastra": "node --env-file=.env --disable-warning=ExperimentalWarning scripts/mastra-live-smoke.mjs",
    "test:e2e": "python tests/browser_e2e.py",
    "smoke:postgres": "node scripts/postgres-smoke.mjs",
    "test:postgres": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/postgres.integration.test.mjs tests/postgres-http.integration.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "pg": "^8.16.3",
    "zod": "4.6.7"
  }
}
