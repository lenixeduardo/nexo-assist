PORT=3000
# PostgreSQL connection string from Supabase > Connect > Transaction pooler.
# Use the PostgreSQL connection URL (not the REST API URL or anon key).
# Set this as a server-side secret in the hosting platform; never commit actual credentials.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# For local PostgreSQL tests ONLY (never enable in production):
# PGSSL_DISABLE=true
# Do not insert sample tickets into production unless explicitly desired.
SEED_DEMO_TICKETS=false
APP_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
# If set, the agent attempts LLM-based structured intent extraction; rules and mutations remain server-side.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=10000
# Enable Mastra adapter after installing @mastra/core and zod: npm install
# Mastra requires Node.js >=22.18 and Gateway OIDC/API key, or OPENAI_API_KEY with MASTRA_PROVIDER=openai.
# The project does NOT silently switch to a fake model when Mastra fails.
USE_MASTRA=true
# gateway uses Vercel OIDC on deploy, or AI_GATEWAY_API_KEY locally.
MASTRA_PROVIDER=gateway
AI_GATEWAY_API_KEY=

OPENAI_API_KEY=
MASTRA_MODEL=openai/gpt-4.1-mini
# Security/deployment: in production, demo login is disabled unless explicitly enabled.
APP_DEMO_LOGIN=false
# Set the exact public https origin in production behind a reverse proxy when available.
# APP_PUBLIC_ORIGIN=https://nexo.example.com
