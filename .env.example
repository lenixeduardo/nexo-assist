PORT=3000
DB_PATH=./data/nexo.sqlite
APP_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
# If set, the agent attempts LLM-based structured intent extraction; rules and mutations remain server-side.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=10000
# Enable Mastra adapter after installing @mastra/core and zod: npm install
# Mastra requires Node.js >=22.18 and a real provider credential.
# The project does NOT silently switch to a fake model when Mastra fails.
USE_MASTRA=false

OPENAI_API_KEY=
MASTRA_MODEL=openai/gpt-4.1-mini
# Security/deployment: in production, demo login is disabled unless explicitly enabled.
APP_DEMO_LOGIN=false
# Set the exact public https origin in production behind a reverse proxy when available.
# APP_PUBLIC_ORIGIN=https://nexo.example.com
